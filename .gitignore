# Local PowerShell analysis cache
Microsoft/

# Local working notes (practices, lessons, open items) and their dated archive
WORKING-NOTES.md
JOURNAL.md

# Cached upstream Claude Code docs used by scripts/gen_claude_config_reference.py
.claude-docs-cache/

# Build output. `uv build` writes the wheel here, and the desktop shell's
# Inno Setup script writes MyClaudeCode-Setup-windows-x86_64.exe here.
/dist/

# Crash dumps written by Git Bash / MSYS when a shell faults. One of these
# (bash.exe.stackdump) was committed by accident and lived in the repo root.
*.stackdump

# Staged documentation and the rendered site (scripts/build_docs_site.py,
# mkdocs). Both are build output for the docs workflow.
/build/

# Node modules for the dashboard jsdom harness (tests/package.json). The
# lockfile is committed; what npm installs from it is not.
node_modules/

# The jsdom harness lock: one run at a time against a tree (see
# tests/api/admin_jsdom_harness.mjs). Released on exit, never committed.
tests/api/.admin_jsdom.lock
