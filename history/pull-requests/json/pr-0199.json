  "title": "fix(chatgpt_oauth): honour the reasoning policy instead of hardcoding medium",
  "user": {
   "login": "FiredMosquito831",
   "id": 79049343,
   "node_id": "MDQ6VXNlcjc5MDQ5MzQz",
   "avatar_url": "https://avatars.githubusercontent.com/u/79049343?v=4",
