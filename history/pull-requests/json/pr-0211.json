  "title": "fix(output-tokens): floor the context-headroom bound instead of emitting a 3-token budget",
  "user": {
   "login": "FiredMosquito831",
   "id": 79049343,
   "node_id": "MDQ6VXNlcjc5MDQ5MzQz",
