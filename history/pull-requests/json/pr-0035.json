   "sha": "c2a49c7f7f18341f4e28ace03cf5de14b29bca74",
   "node_id": "C_kwDOSVPsWtoAKGMyYTQ5YzdmN2YxODM0MWY0ZTI4YWNlMDNjZjVkZTE0YjI5YmNhNzQ",
   "commit": {
    "author": {
     "name": "Contributor",
     "email": "dev@example.com",
     "date": "2026-08-06T16:02:19Z"
