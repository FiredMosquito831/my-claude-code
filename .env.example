# All Claude model requests are mapped to these models, plain model is fallback
# Format: provider_type/model/name
# Valid providers: "anthropic" | "anthropic_oauth" | "nvidia_nim" | "open_router" | "gemini" | "deepseek" | "mistral" | "mistral_codestral" | "opencode" | "opencode_go" | "vercel" | "huggingface" | "cohere" | "github_models" | "wafer" | "kimi" | "minimax" | "cerebras" | "groq" | "sambanova" | "fireworks" | "novita" | "nous_portal" | "kilo" | "commandcode" | "cline" | "cloudflare" | "zai" | "qwencloud" | "qwencloud_coding" | "agnes" | "wandb" | "bedrock" | "tokenrouter" | "nararoute" | "xai" | "together" | "deepinfra" | "siliconflow" | "nebius" | "chutes" | "featherless" | "alibaba_coding" | "alibaba_coding_cn" | "alibaba" | "alibaba_cn" | "ollama_cloud" | "lmstudio" | "llamacpp" | "ollama"
MODEL_FABLE=
MODEL_OPUS=
MODEL_SONNET=
MODEL_HAIKU=
MODEL="nvidia_nim/nvidia/nemotron-3-super-120b-a12b"


# Fallback chains: comma-separated provider/model refs, tried in order when the
# model before them fails BEFORE any response has started streaming. Once the
# first chunk is on the wire the answer is committed and no fallback runs, so a
# request never gets two models spliced into one reply.
#
# A model that accepts the request and then goes silent counts as a failure
# too: see FALLBACK_FIRST_TOKEN_TIMEOUT below. Without that deadline a stalled
# model holds the request until the transport read timeout, and the chain only
# gets its turn minutes later.
#
# A route uses its own chain when it has its own override above; otherwise it
# uses MODEL_FALLBACKS. The two are never merged.
#   MODEL_OPUS set   -> MODEL_OPUS, then MODEL_OPUS_FALLBACKS
#   MODEL_OPUS unset -> MODEL, then MODEL_FALLBACKS
# Example: MODEL_FALLBACKS="cerebras/qwen-3-coder-480b,groq/moonshotai/kimi-k2"
MODEL_FALLBACKS=
MODEL_FABLE_FALLBACKS=
MODEL_OPUS_FALLBACKS=
MODEL_SONNET_FALLBACKS=
MODEL_HAIKU_FALLBACKS=


# Vision adapter. When a request contains an image and the model the route
# picked is KNOWN not to accept images, the request is served by this model
# instead. Capability comes from what the provider publishes, topped up from
# the models.dev catalog; a model nobody reports on is left alone rather than
# diverted.
MODEL_VISION=

# Fallbacks for the vision adapter itself, same comma-separated form as the
# tier chains above. One unreachable vision model would otherwise lose every
# image on the machine. An entry known to reject images is skipped.
MODEL_VISION_FALLBACKS=


# ---------------------------------------------------------------------------
# Model visibility
# ---------------------------------------------------------------------------
# Which models appear in lists. A gateway can publish hundreds of models --
# nous_portal alone lists 343 -- and all of them otherwise land in /v1/models
# (what `mcc-claude --discover-models` writes into Claude Code, and what the
# Codex catalog is built from) and in the Admin model pickers.
#
# Both are comma-separated glob patterns matched case-insensitively against
# the full provider/model reference, e.g.
#   nvidia_nim/thinkingmachines/inkling   an exact model
#   commandcode/*                         one provider
#   *:free                                every free variant
#   *inkling*                             any ref containing the word
#
# HIDE ONLY. Neither list affects routing: a model named in MODEL, MODEL_OPUS
# or any MODEL_*_FALLBACKS chain still resolves and still serves requests
# while hidden. A filter that silently broke a working chain would be worse
# than a chain entry that is invisible but alive.

# Empty means allow everything. A non-empty list makes visibility opt-in:
# only models matching one of these patterns are listed.
MODEL_VISIBILITY_ALLOW=

# Applied after the allow list, and wins over it. Lets a broad allow be
# trimmed without having to enumerate every survivor.
MODEL_VISIBILITY_DENY=


# ---------------------------------------------------------------------------
# Output tokens
# ---------------------------------------------------------------------------
# How many tokens one request may ask the routed model to generate.
#
# The model's own published limit governs. FCC reads it from the provider's
# /models payload first and the models.dev catalogue second, and sends exactly
# that when the client names no max_tokens -- so a 262,144-token model is used
# as a 262,144-token model. A client value above the model's limit is lowered
# to the limit rather than sent to be rejected; a client value below it is left
# alone. The settings here only cover what that cannot answer.

# Used only when nothing published an output limit for the routed model.
# A fallback for a missing client value, not a cap on a present one: capping an
# explicit request against a number nobody published would be an invented
# limit. Defaults to 32768.
MAX_OUTPUT_TOKENS_UNKNOWN_DEFAULT=32768

# Absolute head on output tokens for every request, whatever the model can do,
# and it applies whether the request reasons or not. It ships set at 131072
# because a thinking request is widened to the routed model's own published
# limit -- see MAX_OUTPUT_TOKENS_UNKNOWN_DEFAULT above and the reasoning
# settings below -- and an unbounded ask reserves the whole allowance against
# hosts that pre-reserve max_tokens for rate limiting. It never raises a model
# above its own limit. Set 0 to lift the ceiling entirely; leaving this blank
# means "use the default", not "no ceiling".
MAX_OUTPUT_TOKENS_CEILING=131072

# Tokens reserved for the prompt when a model's output limit is as large as its
# whole context window -- 15% of the models.dev catalogue publishes
# limit.output == limit.context, and on those, asking for the full output
# leaves no room for the messages. When the remaining context is smaller than
# the output budget, the budget is lowered to fit, minus this margin. The
# margin covers the gap between FCC's token count and the upstream tokenizer
# plus the provider's chat template. Set 0 to reserve nothing.
MAX_OUTPUT_TOKENS_CONTEXT_MARGIN=1024

# Smallest budget the reserve above is allowed to produce. If a model's
# published context is wrong, or simply small against a long prompt, the
# subtraction can leave a handful of tokens -- and a request carrying
# max_tokens: 3 succeeds and returns a one-token answer, which looks like the
# model had nothing to say rather than like a misconfigured context length.
# Below this floor the request is sent unchanged so the provider names the real
# context error instead. 4096 is the entire output limit many catalogue entries
# publish and the smallest context window in the catalogue, so a surviving
# request is genuinely useful; it is also a quarter of REASONING_ANSWER_FLOOR_MAX
# so it never rejects prompts the thinking split would happily run. Set 0 to
# send any positive headroom, however small.
MAX_OUTPUT_TOKENS_CONTEXT_FLOOR=4096

# Most tokens ever held back from a request's output allowance for the visible
# answer while extended thinking is on. Thinking tokens and answer tokens are
# spent from the same max_tokens, so without a reserve a thinking budget can
# swallow the whole allowance and leave the model nothing to reply with. The
# reserve actually applied is the smaller of this and half the model's output
# allowance, so a 16,384-output model still gets a working thinking budget
# instead of zero. Set 0 to reserve nothing.
# A larger allowance does not change this reserve -- it is a cap, not a share --
# so a request widened for reasoning spends the extra tokens on thinking.
REASONING_ANSWER_FLOOR_MAX=16384


# ---------------------------------------------------------------------------
# Fallback timing
# ---------------------------------------------------------------------------
# A chain can only rescue a request while nothing has reached the client, so a
# model that accepts a request and then goes silent has to be declared stalled
# inside that window. Without a deadline the only thing that ends a silent
# attempt is the transport read timeout, minutes later and long past any use.

# Every numeric limit below accepts a range, shown next to it in the admin UI.
# Leaving one blank means "use the default", not "invalid": a cleared value can
# never stop the server from starting. A value outside its range is clamped at
# startup with a warning, and refused up front by the admin form.

# Seconds to wait for a model's first output before handing over to the next
# model on the chain. Nothing has streamed yet, so the swap is invisible to the
# client. Defaults to 120s. Set 0 to wait indefinitely.
FALLBACK_FIRST_TOKEN_TIMEOUT=120

# Whole-request budget across every attempt, retry and recovery. Each attempt
# gets an equal share of whatever is left until it produces output, so a silent
# model cannot spend the budget and leave the chain no turn; time an attempt
# does not use flows forward to the models behind it. Once output has started
# the attempt owns the rest of the budget, because cutting a working answer to
# preserve a fallback is the wrong trade. Defaults to 600s. Set 0 to disable.
FALLBACK_TOTAL_TIMEOUT=600

# Seconds a model that has already produced output may then say nothing.
#
# The first-token deadline above stops applying the moment content appears, so
# without this the only thing bounding a stream that starts well and then dies
# is the whole-request budget. It cannot fall back -- part of an answer has
# already reached the client, and swapping models would splice two of them --
# but it should still stop, and stop long before the budget.
#
# Measured from the last chunk that moved the answer forward, not from the last
# frame of any kind: a keepalive proves the connection is alive, not that the
# answer is advancing, and a guard that accepted one would never fire on the
# streams it exists for. A model producing steadily is therefore never cut,
# however long its answer runs.
#
# Deliberately the same number as FALLBACK_FIRST_TOKEN_TIMEOUT rather than a
# new one: it answers the same question, and silence mid-answer is if anything
# more suspicious than silence before it. Set 0 to allow an unlimited pause.
FALLBACK_STALL_TIMEOUT=120

# Failure kinds that end a route instead of trying the next model.
#
# A malformed request is the caller's, not the model's: the same body fails
# identically everywhere, so a three-model chain buys three round trips to the
# same 400. Everything else -- timeout, upstream, rate_limit, overloaded,
# authentication, permission, unavailable -- is a property of the model or the
# moment, which is exactly what a chain is for.
#
# Comma-separated. Leave empty to fall back on every failure. An unknown name
# is refused at startup rather than ignored, because a typo here would fail
# open and the setting would look applied while doing nothing.
FALLBACK_SKIP_KINDS=invalid_request

# Whether a model that has streamed only its reasoning may still fall back.
#
# Reasoning deltas normally count as answer content, so the first thought
# commits the route: the client has seen bytes, no other model may take over,
# and a model that thinks without ever answering holds the request until the
# whole-request budget ends it. Measured on 21 days of this traffic, 44 of 499
# budget exhaustions were a stream that had only reasoned, and 490 of the 499
# never left the first model on the chain.
#
# On (default), reasoning is held back like an envelope frame. The attempt
# stays uncommitted, so its share of the budget expires and the next model
# answers instead. The cost is that reasoning no longer streams live: it
# arrives with the answer, or when the holdback's byte cap forces a commit.
# Set false to watch a model think in real time and accept the old behaviour.
FALLBACK_ON_REASONING_ONLY=true

# Seconds a model may think before the route stops waiting for an answer.
#
# Only meaningful while FALLBACK_ON_REASONING_ONLY is on, because only then is
# a thinking attempt still abandonable. Deliberately a flat allowance rather
# than the attempt's share of FALLBACK_TOTAL_TIMEOUT: that share is sized for a
# model which has shown nothing at all, and 600s divided by an eleven-model
# chain leaves 54s, which is far too little for a model that thinks.
#
# The number comes from the traffic, not from taste. Every request that ran out
# of budget while thinking used the full 600s, and 98% of slow reasoning
# requests that did answer had started answering inside 300s -- so 300 sits
# almost exactly on the boundary between "thinking hard" and "looping".
#
# Set 0 to let a thinking model run to the whole request budget.
FALLBACK_REASONING_ANSWER_TIMEOUT=300

# Seconds a closing server generation gives in-flight requests to finish before
# the supervisor force-drops them during a reload or process replace. Defaults
# to 300s (just over the measured p99.9 whole-request budget); most healthy
# requests drain, though ones longer than the budget (up to the 600s total
# above) may still be cut. The floor is 1s; 0 would be an immediate, no-drain
# shutdown rather than waiting.
SERVER_GRACEFUL_SHUTDOWN_SECONDS=300

# Master switch for benching a failing provider/model. On by default. When
# false, NONE of the FALLBACK_EJECT_* knobs below do anything and the provider
# rate-limit skip is bypassed too: every failure falls straight through to the
# next model in the chain, and a flapping model is re-tried at position 0 on
# every request instead of being parked. Turn it off only if you want a route
# to always attempt its primary.
#
# This shipped defaulting to false in 5.58.0-5.60.0 and was undocumented here,
# so upgrades silently disabled ejection while the settings below stayed set
# and looked active. Restored to true in 5.61.0.
FALLBACK_BENCH_ENABLED=true

# Consecutive failures before routing skips a provider/model, and how long it
# stays skipped. Without this every request re-pays a dead model's timeout on
# its way to a healthy fallback. Never skips the whole chain: if every model is
# benched the chain is tried in order anyway. Defaults to 3 failures / 30s.
# Requires FALLBACK_BENCH_ENABLED=true (the default).
FALLBACK_EJECT_AFTER_FAILURES=3
FALLBACK_EJECT_SECONDS=30

# Eject mode. rate_based (default) benches a model when the failure rate over
# the last FALLBACK_EJECT_WINDOW requests crosses FALLBACK_EJECT_FAILURE_RATE
# (with at least FALLBACK_EJECT_MIN_SAMPLES observed, so a single failure on a
# low-traffic model cannot trip it). legacy preserves the historical
# consecutive-count behavior keyed on FALLBACK_EJECT_AFTER_FAILURES /
# FALLBACK_EJECT_SECONDS above. One-off blips on an otherwise-healthy model
# never bench it in rate_based mode; a genuinely-down model trips fast.
FALLBACK_BEHAVIOR=rate_based

# Retry policy on the primary's first failure. skip (default) moves to the
# next fallback immediately. retry_once gives the primary one more chance
# for transient errors (timeout, 5xx, 429) before falling through. Auth and
# invalid-request errors are never retried regardless. Applies only to the
# primary (position 0); already-failed fallbacks are not retried.
FALLBACK_RETRY_FIRST=skip

# Rate-based eject knobs (ignored when FALLBACK_BEHAVIOR=legacy).
# A model is benched for FALLBACK_EJECT_SECONDS seconds when at least
# FALLBACK_EJECT_FAILURE_RATE of its last FALLBACK_EJECT_WINDOW requests
# failed, with at least FALLBACK_EJECT_MIN_SAMPLES observed so the rate
# is meaningful. Defaults: 10 requests, 50% failure rate, 8 min samples,
# 3s bench. One-off blips do not trip; sustained failures do.
FALLBACK_EJECT_WINDOW=10
FALLBACK_EJECT_FAILURE_RATE=0.5
FALLBACK_EJECT_MIN_SAMPLES=8

# How many times one model is retried on a 429 or 5xx before the chain moves
# on. Each retry waits longer than the last, so 5 attempts spend about 30s
# before a healthy fallback is tried.
PROVIDER_RETRY_ATTEMPTS=5

# Attempts a provider makes on its own, before routing sees the failure.
STREAM_EARLY_RETRY_ATTEMPTS=5

# After output has started and the connection drops, how many times the same
# model is asked to finish. No chain can help here, so this bounds how long a
# dying stream may hold a request.
STREAM_MIDSTREAM_RECOVERY_ATTEMPTS=5

# Seconds the first output is held before it commits. While held, a failure can
# still fall back invisibly, so this is the width of that window. 0 commits at
# once and disables invisible recovery.
STREAM_COMMIT_HOLDBACK_SECONDS=0.75

# Applied only when a rate-limited provider sends no Retry-After of its own.
RATE_LIMIT_COOLDOWN_SECONDS=60

# A key's health only ever moves on a signal about the key itself: 401/403
# walks the lockout ladder below, and a 429 is benched for exactly as long as
# the provider asked. Timeouts, 5xx, 410 and 4xx leave every key untouched --
# they are the model's problem, so the fallback chain moves to the next model.
CREDENTIAL_LOCKOUT_TIERS=300,3600,86400

# Shortest remaining cooldown worth routing a model around instead of waiting.
FALLBACK_COOLDOWN_STEP_OVER_FLOOR=5

# Backoff between one provider's own retries of a 429 or 5xx: first wait,
# ceiling, and the random spread added to each so clients do not retry
# in lockstep.
PROVIDER_RETRY_BACKOFF_BASE_SECONDS=2
PROVIDER_RETRY_BACKOFF_MAX_SECONDS=60
PROVIDER_RETRY_BACKOFF_JITTER_SECONDS=1

# Request log storage. MAX_ROWS keeps the newest N requests; all-time counters
# keep counting either way. TEXT_MAX_CHARS also bounds what search can find.
# WIRE_BODY_MAX_CHARS bounds the message and tool structure stored per outbound
# body; sampling and reasoning parameters are always stored whole regardless.
REQUEST_LOG_MAX_ROWS=50000
REQUEST_LOG_TEXT_MAX_CHARS=50000
REQUEST_LOG_WIRE_BODY_MAX_CHARS=8000
REQUEST_LOG_COMPRESSION_LEVEL=9
REQUEST_LOG_QUEUE_MAX_SIZE=10000

# Images a request carried. The count is always recorded; CAPTURE_IMAGES keeps a
# downscaled copy so the request detail can show what the model looked at, and
# IMAGE_MAX_PIXELS is its longest edge (0 records the image without any pixels).
# The same picture re-sent on later turns is stored once.
REQUEST_LOG_CAPTURE_IMAGES=true
REQUEST_LOG_IMAGE_MAX_PIXELS=512

# ---------------------------------------------------------------------------
# Desktop tray/window (mcc-desktop)
# ---------------------------------------------------------------------------
# mcc-desktop is a SEPARATE PROCESS from the server. It reads these once, at
# launch, so a change made here (or in the dashboard) applies to the next
# mcc-desktop start, not to a tray already running.

# Tight poll used while waiting for a freshly spawned mcc-server child to
# become healthy.
DESKTOP_HEALTH_CHECK_INTERVAL=0.25

# How long to wait for a spawned mcc-server child to become healthy before
# reporting a start failure.
DESKTOP_SERVER_START_TIMEOUT=15

# Timeout for one loopback call to the server's admin API.
DESKTOP_ADMIN_REQUEST_TIMEOUT=5

# How often the tray polls for another instance's "show my window" signal.
DESKTOP_ACTIVATION_POLL_SECONDS=1

# How often the tray's background thread probes the running server (the
# ongoing health monitor, distinct from the startup poll above).
DESKTOP_HEALTH_POLL_SECONDS=5

# Consecutive failed health probes before the tray reports an outage. This is
# what stops a self-update restart -- the server briefly replacing its own
# process -- from being read as death.
DESKTOP_HEALTH_FAILURE_THRESHOLD=3

# Desktop window size, in CSS pixels, for the app-mode/embedded window.
DESKTOP_WINDOW_WIDTH=1400
DESKTOP_WINDOW_HEIGHT=900

# Explicit path to a Chromium-family binary (Chrome/Edge/Brave/Chromium). When
# set, it takes precedence over the built-in candidate search, which is
# otherwise the only way a browser can be found. When set but the path does
# not exist, mcc-desktop logs a warning and falls through to the search
# instead of failing to open a window. Empty searches the usual install
# locations and PATH.
DESKTOP_BROWSER_PATH=


