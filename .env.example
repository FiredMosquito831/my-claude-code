# `fcc-chatgpt-oauth-login --browser` is only for a browser sharing MCC's localhost.
# MCC stores renewable credentials under ~/.fcc/auth.
# A raw CHATGPT_OAUTH_ACCESS_TOKEN is an advanced, non-refreshable override.
CHATGPT_OAUTH_ACCESS_TOKEN=""
CHATGPT_OAUTH_ACCOUNT_ID=""
CHATGPT_OAUTH_BASE_URL=""
CHATGPT_OAUTH_PROXY=""


