# Messaging Platform: "telegram" | "discord" | "none"
MESSAGING_PLATFORM="discord"
MESSAGING_RATE_LIMIT=1
MESSAGING_RATE_WINDOW=1


# Voice Note Transcription
VOICE_NOTE_ENABLED=false
# WHISPER_DEVICE: "cpu" | "cuda" | "nvidia_nim"
# - "cpu"/"cuda": Hugging Face transformers Whisper (offline, free; install with: uv sync --extra voice_local)
# - "nvidia_nim": NVIDIA NIM Whisper via Riva gRPC (requires NVIDIA_NIM_API_KEY; install with: uv sync --extra voice)
# (Independent of MODEL=nvidia_nim/...: that selects the *chat* provider; this selects voice STT only.)
WHISPER_DEVICE="nvidia_nim"
# WHISPER_MODEL:
# - For cpu/cuda: Hugging Face ID or short name (tiny, base, small, medium, large-v2, large-v3, large-v3-turbo)
# - For nvidia_nim: NVIDIA NIM model (e.g., "nvidia/parakeet-ctc-1.1b-asr", "openai/whisper-large-v3")
# - For nvidia_nim, default to "openai/whisper-large-v3" for best performance
WHISPER_MODEL="openai/whisper-large-v3"


# Telegram Config
TELEGRAM_BOT_TOKEN=""
ALLOWED_TELEGRAM_USER_ID=""
# Optional Telegram-only proxy.
# Supported schemes: http, https, socks4, socks5, socks5h.
# Example: "socks5://127.0.0.1:1080" or "https://user:password@host:port"
TELEGRAM_PROXY_URL=""


# Discord Config
DISCORD_BOT_TOKEN=""
ALLOWED_DISCORD_CHANNELS=""


# Agent Config
ALLOWED_DIR=""
ENABLE_TITLE_GENERATION_SKIP=true
ENABLE_SUGGESTION_MODE_SKIP=true


# Tool-Result Trimming (Read / Grep / Glob)
# Elide the middle of oversized Read/Grep/Glob results before they reach the
# model. OFF BY DEFAULT. This is the only setting here that changes what the
# model sees, so treat it as such: every elision carries an inline marker
# saying MCC removed content and how much, but a marker is not the content.
# Bash is deliberately out of scope -- client-side hooks already compress it.
ENABLE_TOOL_RESULT_TRIMMING=false
# Per-rule: off | observe | on.
#   off      leaves results untouched.
#   observe  measures what would be removed and records it; the wire is
#            unchanged. Run a rule here against real traffic first.
#   on       performs the elision and marks it inline.
TOOL_RESULT_TRIM_READ=off
TOOL_RESULT_TRIM_GREP=off
TOOL_RESULT_TRIM_GLOB=off
# A result shorter than this is never considered. The default is the measured
# p90 of a whole-file Read in a real repository (p50 3,012; p90 20,735;
# max 374,612 characters), so ~90% of reads pass through untouched.
TOOL_RESULT_TRIM_THRESHOLD_CHARS=20000
# Kept from each end of a trimmed body, snapped out to a line boundary so a
# path or a numbered line is never cut in half. Only the middle is removed.
TOOL_RESULT_TRIM_KEEP_HEAD_CHARS=4000
TOOL_RESULT_TRIM_KEEP_TAIL_CHARS=4000
# Newest attributable results that are never trimmed.
#
# MEASURED WARNING, read before enabling trimming at all. This setting, not
# trimming itself, decides whether the feature saves tokens or costs them. A
# protected result is re-trimmed later, when it ages out of the window, and
# that rewrites bytes in the middle of an already-cached prefix. Over a
# 24-turn session against a prefix-cache model (same sign at cache-block
# granularity 1, 128 and 1024):
#
#   protect_recent        fresh tokens   cache hit   chars removed
#   0                           72,897       91.9%      15,024,408
#   1                          486,278       62.5%      13,781,644
#   2 (this default)           521,860       69.1%      12,561,418
#   4                          955,949       59.8%      10,409,077
#   trimming off               470,648       91.8%               0
#
# So the default here costs 10.9% MORE fresh input tokens than leaving
# trimming off, and turning trimming on mid-conversation costs one near-total
# cache miss. Break-even is a baseline cache hit rate around 90.9%: below it
# trimming wins, above it trimming loses. Check your own hit rate first.
#
# 0 is prefix-stable and cuts fresh tokens 84.5%, but the model then never
# sees the full text of the read it just issued. That cost is unmeasured,
# which is why the default is not 0.
TOOL_RESULT_TRIM_PROTECT_RECENT_RESULTS=2


# Local Anthropic web_search / web_fetch handling (performs outbound HTTP; on by default)
ENABLE_WEB_SERVER_TOOLS=true
WEB_FETCH_ALLOWED_SCHEMES=http,https
WEB_FETCH_ALLOW_PRIVATE_NETWORKS=false


# Web Search Providers
# Backend for Claude Code's official web_search server tool.
# "auto" = first configured provider below (catalog order), else DuckDuckGo (keyless).
# "off" = legacy DuckDuckGo HTML scrape only (compatibility).
# "disabled" = reject web searches without outbound traffic. Or pin one provider id:
# ddgs | ollama | exa | tavily | brave | searxng | jina | serper | firecrawl | linkup | perplexity | parallel | searchapi | serpapi
WEB_SEARCH_PROVIDER=auto
# auto = resilient fallback only for auto-selection; a named provider is strict.
# none = no fallback; ddgs = selected -> DDGS; legacy = selected -> DDGS -> legacy scrape.
WEB_SEARCH_FALLBACK_POLICY=auto

# Multiple keys per provider: comma-separate them in the same variable.
# Optional per-provider rotation policy: single | round_robin | least_used | failover
# (default: failover when multiple keys are set, single otherwise), e.g.:
# EXA_API_KEY_ROTATION=round_robin

# Ollama Web Search (free hosted tier; key at https://ollama.com/settings/keys)
OLLAMA_SEARCH_API_KEY=""
# Exa (key at https://dashboard.exa.ai/api-keys)
EXA_API_KEY=""
# Tavily (1,000 free credits/month; key at https://app.tavily.com/home)
TAVILY_API_KEY=""
# Brave Search ($5 free credits/month; key at https://api-dashboard.search.brave.com/)
BRAVE_SEARCH_API_KEY=""
# Jina Search (10M free tokens for new keys; key at https://jina.ai/api-dashboard/)
JINA_API_KEY=""
# Serper (Google SERP; 2,500 free one-time queries; key at https://serper.dev/api-key)
SERPER_API_KEY=""
# Firecrawl (key at https://www.firecrawl.dev/app/api-keys)
FIRECRAWL_API_KEY=""
# Linkup ($20 free credit topped up monthly; key at https://app.linkup.so/)
LINKUP_API_KEY=""
# Perplexity Search (key at https://www.perplexity.ai/settings/api; mint a fresh key)
PERPLEXITY_SEARCH_API_KEY=""
# Parallel Search API beta (key at https://platform.parallel.ai/)
PARALLEL_API_KEY=""
# SearchAPI.io (100 free one-time requests; key at https://www.searchapi.io/)
SEARCHAPI_API_KEY=""
# SerpAPI (250 free searches/month; key at https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=""

# SearXNG self-hosted instance (no key; enable format=json in its settings.yml)
SEARXNG_BASE_URL=""

# Optional outbound proxy for web search providers (http/socks5)
WEBSEARCH_PROXY=""

# Web search usage analytics (SQLite under ~/.fcc/logs/)
WEBSEARCH_LOG_ENABLED=true
WEBSEARCH_LOG_MAX_ROWS=50000
# Capture full normalized provider input/output for Admin detail views.
# false stores only character counts + SHA-256 hashes; query previews remain searchable.
WEBSEARCH_LOG_CAPTURE_CONTENT=true
# Per-input/output JSON cap. Default (~2 MB) retains real provider output in full;
# oversized payloads become a valid JSON truncation envelope. Lower to bound disk.
WEBSEARCH_LOG_CONTENT_MAX_CHARS=2000000

# Rich digest for Claude Code's web_search text block:
# per-result excerpt character cap and the optional provider answer lead.
WEBSEARCH_DIGEST_CHARS=600
WEBSEARCH_DIGEST_ANSWER=true
# Cap for extracted page text, used instead of the snippet when a provider
# returns it (EXA_CONTENTS, TAVILY_INCLUDE_RAW_CONTENT, FIRECRAWL_SCRAPE_FORMAT,
# BRAVE_EXTRA_SNIPPETS; Jina/Parallel/Linkup return it by default). Separate
# from the snippet cap so opting into content is not trimmed to snippet length.
# Raise for more grounding, lower to control input tokens, 0 = snippets only.
WEBSEARCH_DIGEST_CONTENT_CHARS=2000


# ==================== Web Search Advanced Options ====================
# Optional per-provider knobs (all dotenv-only; empty = provider default
# behavior, identical to leaving them unset). Cost notes inline.

# --- Exa ---
# EXA_SEARCH_TYPE=            # instant|fast|auto|deep-lite|deep|deep-reasoning (deep* = $0.015/query vs $0.005)
# EXA_CONTENTS=               # highlights|text|highlights+text|highlights+summary|full (+$0.001/page per content type)
# EXA_CATEGORY=               # company|people|research paper|news|personal site|financial report (company/people disable date+exclude filters)
# EXA_MAX_AGE_HOURS=          # crawl cache max age; 0 = always fresh
# EXA_START_PUBLISHED_DATE=   # ISO 8601 lower bound on publishedDate
# EXA_END_PUBLISHED_DATE=     # ISO 8601 upper bound on publishedDate
# EXA_USER_LOCATION=          # 2-letter country code for geo relevance

# --- DuckDuckGo (ddgs) ---
# DDGS_BACKEND=               # bing|brave|duckduckgo|google|mojeek|startpage|yandex|yahoo|wikipedia (free; default auto)
# DDGS_REGION=                # e.g. us-en
# DDGS_TIMELIMIT=             # d|w|m|y (free freshness filter)
# DDGS_SAFESEARCH=            # on|moderate|off (default moderate)

# --- Brave Search ---
# BRAVE_SEARCH_MODE=          # web|llm-context (llm-context = $5/1k, returns pre-extracted page text)
# BRAVE_EXTRA_SNIPPETS=false  # extra snippets per result (plan-gated)
# BRAVE_FRESHNESS=            # pd|pw|pm|py
# BRAVE_COUNTRY=              # 2-letter country code (web mode)
# BRAVE_SEARCH_LANG=          # ISO 639-1 content language (web mode)
# BRAVE_LLM_MAX_TOKENS=       # 1024-32768, llm-context mode only
# BRAVE_SAFESEARCH=           # off|moderate|strict (default moderate)

# --- SearXNG ---
# SEARXNG_ENGINES=            # comma list of engine names
# SEARXNG_CATEGORIES=         # comma list of categories
# SEARXNG_TIME_RANGE=         # day|month|year
# SEARXNG_LANGUAGE=           # language code or "all"
# SEARXNG_SAFESEARCH=         # 0|1|2 (empty = the instance's own default)

# --- Jina Search ---
# JINA_MAX_TOKENS=            # X-Max-Tokens header; token-billed, best cost guardrail
# JINA_SITE=                  # restrict results to one site
# JINA_GL=                    # geo country code

# --- Serper ---
# SERPER_GL=                  # 2-letter country
# SERPER_HL=                  # language code
# SERPER_TBS=                 # Google tbs date filter, e.g. qdr:w
# SERPER_RICH_BLOCKS=true     # capture answerBox/knowledgeGraph/peopleAlsoAsk into the answer lead (default on)

# --- Firecrawl ---
# FIRECRAWL_SOURCES=          # web | web,news | web,news,images
# FIRECRAWL_SCRAPE_FORMAT=    # summary|markdown (multiplies credits per result)
# FIRECRAWL_TBS=              # date filter, e.g. qdr:d
# FIRECRAWL_LOCATION=         # free-text location
# FIRECRAWL_COUNTRY=          # ISO code; Firecrawl defaults to US when unset
# FIRECRAWL_CATEGORIES=       # github|research|pdf (comma separated)

# --- Tavily ---
# TAVILY_SEARCH_DEPTH=        # basic|fast|ultra-fast|advanced (advanced = 2 credits/query)
# TAVILY_TOPIC=               # general|news|finance
# TAVILY_TIME_RANGE=          # day|week|month|year
# TAVILY_INCLUDE_ANSWER=      # basic|advanced (LLM answer lead)
# TAVILY_INCLUDE_RAW_CONTENT= # markdown|text (free full page text, may add latency)
# TAVILY_CHUNKS_PER_SOURCE=   # 1-3 snippets per source (empty = 3); cheapest way to get more text
# TAVILY_COUNTRY=              # country boost, general topic only
# TAVILY_START_DATE=           # YYYY-MM-DD lower bound (finer than time range)
# TAVILY_END_DATE=             # YYYY-MM-DD upper bound

# --- Linkup ---
# LINKUP_DEPTH=               # standard|deep (deep = 10x, $0.05/query)
# LINKUP_OUTPUT_TYPE=         # searchResults|sourcedAnswer (sourcedAnswer = +$0.001, returns answer+sources)
# LINKUP_FROM_DATE=           # YYYY-MM-DD lower bound on publish date
# LINKUP_TO_DATE=             # YYYY-MM-DD upper bound on publish date

# --- Perplexity Search ---
# PERPLEXITY_SEARCH_RECENCY=  # hour|day|week|month|year
# PERPLEXITY_CONTEXT_SIZE=    # low|medium|high (omitted when max tokens per page is set)
# PERPLEXITY_MAX_TOKENS_PER_PAGE=  # per-page extraction cap

# --- Parallel ---
# PARALLEL_MODE=              # turbo|basic|advanced (turbo cheapest, advanced highest quality)
# PARALLEL_EXCERPT_CHARS=     # max excerpt chars per result
# PARALLEL_TOTAL_CHARS=       # max total excerpt chars across results
# PARALLEL_LOCATION=          # country code for geo targeting

# --- SearchAPI.io ---
# SEARCHAPI_ENGINE=           # google|google_news|google_scholar|bing
# SEARCHAPI_TIME_PERIOD=      # last_hour|last_day|last_week|last_month|last_year
# SEARCHAPI_GL=               # country code
# SEARCHAPI_HL=               # language code
# SEARCHAPI_SAFE=             # active|blur|off

# --- SerpAPI ---
# SERPAPI_ENGINE=             # google|google_light|bing (google_light: cheaper, num=100 works)
# SERPAPI_TBS=                # date filter, e.g. qdr:w
# SERPAPI_GL=                 # country code
# SERPAPI_HL=                 # language code
# SERPAPI_SAFE=               # active|off


# Structured traces: DEBUG lines with `"trace": true` merge
# ingress/routing/cli/provider/egress stages. Conversation text is logged in those payloads
# (verbatim). Values under keys named like ``api_key`` / ``authorization`` are redacted.
# Raw transport payloads still require the LOG_RAW_* toggles below.
#
# Minimum log level for the JSON file sink: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Defaults to INFO. Use DEBUG temporarily for detailed request traces, or WARNING for quieter logs.
# The file rotates at 50 MB and retains five rotated files (roughly 300 MB including the active file).
LOG_LEVEL=INFO
#
# Verbose diagnostics (avoid logging raw prompts / SSE bodies in production)
DEBUG_PLATFORM_EDITS=false
DEBUG_SUBAGENT_STACK=false
# When true, also allows DEBUG-level httpx/httpcore/telegram log noise (not just payload logging).
LOG_RAW_API_PAYLOADS=false
LOG_RAW_SSE_EVENTS=false
# When true, log full exception text and tracebacks for unhandled errors (may leak request-derived data).
LOG_API_ERROR_TRACEBACKS=false
# When true, log message/transcription text previews in messaging adapters only (handler ingress always TRACEs verbatim text separately).
LOG_RAW_MESSAGING_CONTENT=false
# When true, log full Claude CLI stderr, non-JSON stdout lines, and parser error text.
LOG_RAW_CLI_DIAGNOSTICS=false
# When true, log full exception and CLI error message strings in messaging (may leak user content).
LOG_MESSAGING_ERROR_DETAILS=false
